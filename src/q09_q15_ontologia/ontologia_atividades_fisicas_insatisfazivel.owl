<owl:Class rdf:about="#UsuarioSemCondicaoDeSaude">
  <rdfs:subClassOf rdf:resource="#Usuario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Usuario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temCondicao"/>
          <owl:onClass rdf:resource="#CondicaoDeSaude"/>
          <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="pt-BR">Usuário sem condição de saúde</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Definida: temCondicao max 0. Só é inferida se o mundo for fechado.</rdfs:comment>
</owl:Class>

