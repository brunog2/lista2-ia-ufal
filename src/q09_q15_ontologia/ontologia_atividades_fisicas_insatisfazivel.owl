                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="pt-BR">Atividade adequada para idoso</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Baixo impacto e não vigorosa.</rdfs:comment>
