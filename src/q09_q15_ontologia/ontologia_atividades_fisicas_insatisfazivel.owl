<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://ic.ufal.br/ecom031/lista2/atividades-fisicas"
         xmlns="http://ic.ufal.br/ecom031/lista2/atividades-fisicas#">

<owl:Ontology rdf:about="http://ic.ufal.br/ecom031/lista2/atividades-fisicas">
  <rdfs:label xml:lang="pt-BR">Ontologia de recomendação de atividades físicas</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Ontologia OWL 2 DL usada nas Questões 9 e 15 da Lista 2 de IA (UFAL, ECOM031, 2026.2). Dupla: Bruno Gomes de Barros Filho e Antônio Rodrigo Lima de Andrade Tenório.</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0</owl:versionInfo>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#temImpacto">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="#NivelDeImpacto"/>
  <rdfs:label xml:lang="pt-BR">tem impacto</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Funcional: cada atividade tem um único nível de impacto.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temNivelTecnico">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="#NivelTecnico"/>
  <rdfs:label xml:lang="pt-BR">tem nível técnico</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Funcional.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#realizadaEm">
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="#Local"/>
  <owl:inverseOf rdf:resource="#sediaAtividade"/>
  <rdfs:label xml:lang="pt-BR">realizada em</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#sediaAtividade">
  <owl:inverseOf rdf:resource="#realizadaEm"/>
  <rdfs:label xml:lang="pt-BR">sedia atividade</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Inversa de realizadaEm.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#parteDe">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#ParteDoCorpo"/>
  <rdfs:range rdf:resource="#ParteDoCorpo"/>
  <rdfs:label xml:lang="pt-BR">parte de</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Transitiva: joelho parteDe membro inferior.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#sobrecarrega">
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="#ParteDoCorpo"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#sobrecarrega"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#parteDe"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label xml:lang="pt-BR">sobrecarrega</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Cadeia: sobrecarrega o parteDe -&gt; sobrecarrega.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#afeta">
  <rdfs:domain rdf:resource="#CondicaoDeSaude"/>
  <rdfs:range rdf:resource="#ParteDoCorpo"/>
  <owl:inverseOf rdf:resource="#afetadaPor"/>
  <rdfs:label xml:lang="pt-BR">afeta</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#afetadaPor">
  <owl:inverseOf rdf:resource="#afeta"/>
  <rdfs:label xml:lang="pt-BR">afetada por</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Inversa de afeta.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contraindicadaPara">
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="#CondicaoDeSaude"/>
  <owl:inverseOf rdf:resource="#contraindica"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#sobrecarrega"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#afetadaPor"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label xml:lang="pt-BR">contraindicada para</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Cadeia: sobrecarrega o afetadaPor.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contraindica">
  <owl:inverseOf rdf:resource="#contraindicadaPara"/>
  <rdfs:label xml:lang="pt-BR">contraindica</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Inversa de contraindicadaPara.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temCondicao">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#CondicaoDeSaude"/>
  <rdfs:label xml:lang="pt-BR">tem condição</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#naoDevePraticar">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#AtividadeFisica"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#temCondicao"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#contraindica"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label xml:lang="pt-BR">não deve praticar</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Cadeia: temCondicao o contraindica.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#promove">
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="#Beneficio"/>
  <rdfs:label xml:lang="pt-BR">promove</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dependeDe">
  <rdfs:domain rdf:resource="#Objetivo"/>
  <rdfs:range rdf:resource="#Beneficio"/>
  <owl:inverseOf rdf:resource="#contribuiPara"/>
  <rdfs:label xml:lang="pt-BR">depende de</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contribuiPara">
  <owl:inverseOf rdf:resource="#dependeDe"/>
  <rdfs:label xml:lang="pt-BR">contribui para</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Inversa de dependeDe.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atendeObjetivo">
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="#Objetivo"/>
  <owl:inverseOf rdf:resource="#atendidoPor"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#promove"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#contribuiPara"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label xml:lang="pt-BR">atende objetivo</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Cadeia: promove o contribuiPara.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atendidoPor">
  <owl:inverseOf rdf:resource="#atendeObjetivo"/>
  <rdfs:label xml:lang="pt-BR">atendido por</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Inversa de atendeObjetivo.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temObjetivo">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Objetivo"/>
  <rdfs:label xml:lang="pt-BR">tem objetivo</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temAtividadeCandidata">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#AtividadeFisica"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#temObjetivo"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#atendidoPor"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label xml:lang="pt-BR">tem atividade candidata</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Cadeia: temObjetivo o atendidoPor.</rdfs:comment>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#gastoMET">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="pt-BR">gasto energético (MET)</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Equivalente metabólico médio da atividade.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#custoMensal">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="pt-BR">custo mensal (R$)</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Custo mensal estimado em reais.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#minimoDeParticipantes">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AtividadeFisica"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="pt-BR">mínimo de participantes</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Pessoas necessárias para praticar.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#idade">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="pt-BR">idade</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Idade em anos completos.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#imc">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="pt-BR">IMC</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Índice de massa corporal (kg/m²), calculado fora da ontologia.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#minutosAtivosPorSemana">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="pt-BR">minutos ativos por semana</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Minutos semanais de atividade física moderada ou vigorosa.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#mesesDeExperiencia">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="pt-BR">meses de experiência</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Tempo de prática regular de exercícios, em meses.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#orcamentoMensal">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="pt-BR">orçamento mensal (R$)</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Quanto o usuário aceita pagar por mês.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#prefereAmbiente">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="pt-BR">prefere ambiente</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Preferência declarada: 'ar livre', 'fechado' ou 'indiferente'.</rdfs:comment>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="#exigeAtividadeDoTipo">
  <rdfs:label xml:lang="pt-BR">exige atividade do tipo</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Anotação: liga um perfil de usuário à classe de atividades seguras para ele.</rdfs:comment>
</owl:AnnotationProperty>

<owl:Class rdf:about="#AtividadeFisica">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#promove"/>
      <owl:onClass rdf:resource="#Beneficio"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temImpacto"/>
      <owl:onClass rdf:resource="#NivelDeImpacto"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#realizadaEm"/>
      <owl:onClass rdf:resource="#Local"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#gastoMET"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="pt-BR">Atividade física</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Prática corporal que pode ser recomendada a um usuário.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AtividadeAerobica">
  <rdfs:subClassOf rdf:resource="#AtividadeFisica"/>
  <rdfs:label xml:lang="pt-BR">Atividade aeróbica</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Modalidade predominantemente cardiorrespiratória.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AtividadeDeForca">
  <rdfs:subClassOf rdf:resource="#AtividadeFisica"/>
  <rdfs:label xml:lang="pt-BR">Atividade de força</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Modalidade predominantemente de força e resistência muscular.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AtividadeDeFlexibilidade">
  <rdfs:subClassOf rdf:resource="#AtividadeFisica"/>
  <rdfs:label xml:lang="pt-BR">Atividade de flexibilidade</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Práticas de mobilidade, alongamento e mente-corpo.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Esporte">
  <rdfs:subClassOf rdf:resource="#AtividadeFisica"/>
  <rdfs:label xml:lang="pt-BR">Esporte</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Modalidade com regras e disputa, em geral coletiva.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Usuario">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#idade"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="pt-BR">Usuário</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Pessoa que pede uma recomendação.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CondicaoDeSaude">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="pt-BR">Condição de saúde</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Condição que pode contraindicar atividades.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CondicaoArticular">
  <rdfs:subClassOf rdf:resource="#CondicaoDeSaude"/>
  <rdfs:label xml:lang="pt-BR">Condição articular</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CondicaoDaColuna">
  <rdfs:subClassOf rdf:resource="#CondicaoDeSaude"/>
  <rdfs:label xml:lang="pt-BR">Condição da coluna</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CondicaoCardiovascular">
  <rdfs:subClassOf rdf:resource="#CondicaoDeSaude"/>
  <rdfs:label xml:lang="pt-BR">Condição cardiovascular</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Local">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="pt-BR">Local</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Lugar onde uma atividade é praticada.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LocalAoArLivre">
  <rdfs:subClassOf rdf:resource="#Local"/>
  <owl:disjointWith rdf:resource="#LocalFechado"/>
  <rdfs:label xml:lang="pt-BR">Local ao ar livre</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LocalFechado">
  <rdfs:subClassOf rdf:resource="#Local"/>
  <rdfs:label xml:lang="pt-BR">Local fechado</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LocalAquatico">
  <rdfs:subClassOf rdf:resource="#Local"/>
  <rdfs:label xml:lang="pt-BR">Local aquático</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Piscina, praia ou lagoa; ortogonal a aberto/fechado.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ParteDoCorpo">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="pt-BR">Parte do corpo</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Estrutura corporal que uma atividade pode sobrecarregar.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Beneficio">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="pt-BR">Benefício</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Efeito esperado da prática regular.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Objetivo">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="pt-BR">Objetivo</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Meta declarada pelo usuário.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NivelDeImpacto">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#impacto_baixo"/>
        <rdf:Description rdf:about="#impacto_moderado"/>
        <rdf:Description rdf:about="#impacto_alto"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="pt-BR">Nível de impacto</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Enumeração fechada: baixo, moderado, alto.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NivelTecnico">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#nivel_basico"/>
        <rdf:Description rdf:about="#nivel_intermediario"/>
        <rdf:Description rdf:about="#nivel_avancado"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="pt-BR">Nível técnico</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Enumeração fechada: básico, intermediário, avançado.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AtividadeDeBaixoImpacto">
  <rdfs:subClassOf rdf:resource="#AtividadeFisica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#AtividadeFisica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temImpacto"/>
          <owl:hasValue rdf:resource="#impacto_baixo"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="pt-BR">Atividade de baixo impacto</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Definida: temImpacto value impacto_baixo.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AtividadeDeAltoImpacto">
  <rdfs:subClassOf rdf:resource="#AtividadeFisica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#AtividadeFisica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temImpacto"/>
          <owl:hasValue rdf:resource="#impacto_alto"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="pt-BR">Atividade de alto impacto</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Definida: temImpacto value impacto_alto.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AtividadeLeve">
  <rdfs:subClassOf rdf:resource="#AtividadeFisica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#AtividadeFisica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#gastoMET"/>
