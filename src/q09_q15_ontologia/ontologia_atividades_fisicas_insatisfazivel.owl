          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <exigeAtividadeDoTipo rdf:resource="#AtividadeAdequadaParaObesidade"/>
  <rdfs:label xml:lang="pt-BR">Usuário com obesidade</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Definida: IMC &gt;= 30.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#UsuarioComCondicaoArticular">
  <rdfs:subClassOf rdf:resource="#Usuario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Usuario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temCondicao"/>
          <owl:someValuesFrom rdf:resource="#CondicaoArticular"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="pt-BR">Usuário com condição articular</rdfs:label>
