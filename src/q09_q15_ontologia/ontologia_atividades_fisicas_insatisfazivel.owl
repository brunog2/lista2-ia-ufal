</owl:Class>

<owl:Class rdf:about="#UsuarioIdoso">
  <rdfs:subClassOf rdf:resource="#Usuario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Usuario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#idade"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <exigeAtividadeDoTipo rdf:resource="#AtividadeAdequadaParaIdoso"/>
  <rdfs:label xml:lang="pt-BR">Usuário idoso</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Definida: idade &gt;= 60.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#UsuarioSedentario">
  <rdfs:subClassOf rdf:resource="#Usuario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Usuario"/>
