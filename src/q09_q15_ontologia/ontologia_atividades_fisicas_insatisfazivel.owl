  <rdfs:label xml:lang="pt-BR">Usuário sedentário</rdfs:label>
  <rdfs:comment xml:lang="pt-BR">Definida: menos de 150 minutos ativos por semana (OMS).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#UsuarioIniciante">
  <rdfs:subClassOf rdf:resource="#Usuario"/>
