}
probability ( Dengue | Exposicao ) {
    ( Sim ) 0.2, 0.8;
    ( Nao ) 0.03, 0.97;

}
probability ( DorMuscular | Dengue, Influenza ) {
    ( Sim, Sim ) 0.95, 0.05;
